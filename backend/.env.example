# backend/.env.example
#
# Copy this file to `backend/.env` and fill in the real values.
# `.env` is gitignored — never commit real credentials.

# --- Application ------------------------------------------------------------
APP_NAME=OM Marketing API
DEBUG=True

# --- Security ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Database ---------------------------------------------------------------
DATABASE_URL=sqlite:///./om_marketing.db

# --- Who may call this API (comma separated, no trailing slash) -------------
# In production add your live site, e.g. https://om-marketing.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Outgoing email (Gmail SMTP) --------------------------------------------
# SMTP_PASSWORD must be a Google *App Password*, not the account password.
# 1. Turn on 2-Step Verification on the Google account
# 2. Create an app password at https://myaccount.google.com/apppasswords
# 3. Paste the 16 characters here (spaces are fine, they get stripped)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=OM Marketing

# Where new-enquiry notifications are delivered
OWNER_EMAIL=

# --- Business details shown in emails ---------------------------------------
BUSINESS_NAME=OM Marketing
BUSINESS_PHONE=+919825247312
BUSINESS_PHONE_DISPLAY=98252 47312
BUSINESS_EMAIL=ommarketing.weighingscale1@gmail.com
BUSINESS_ADDRESS=Naroda, Ahmedabad, Gujarat, India
SITE_URL=http://localhost:3000
