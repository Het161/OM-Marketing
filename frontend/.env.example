# frontend/.env.example
#
# Copy to `.env.local` for development. In production set these in the
# Vercel dashboard (Settings → Environment Variables).

# Base URL of the FastAPI backend. No trailing slash.
# Local:      http://localhost:8000
# Production: https://om-marketing-api.onrender.com  (your deployed backend)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public URL of this site — used for canonical URLs, sitemap.xml and
# Open Graph image links. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
